---
import { Image } from 'astro:assets';

const { image, imageAlt, pretitle, title, body, invert } = Astro.props;
---

<div class="grid grid-flow-row gap-y-4 w-full lg:grid-cols-12 mb-32">
  <div
    class={`w-auto mx-auto row-start-2 lg:col-span-7 lg:row-start-1 ${
      invert ? 'lg:col-start-7' : 'lg:col-start-1 lg:col-end-7'
    }`}
  >
    <div
      class="w-full p-3 aspect-square rounded-lg border border-opacity-50 border-body dark:border-primary_dark bg-gradient-to-br from-transparent via-primary/5 dark:via-primary_dark/5 to-transparent"
    >
      <Image
        src={image}
        alt={imageAlt}
        height="600"
        class="object-cover bg-accent dark:bg-accent_dark h-full w-full rounded-md opacity-100"
      />
    </div>
  </div>
  <div
    class={`max-w-[500px] mx-auto lg:col-span-5 flex flex-col items-start mb-8 lg:mb-0 ${
      invert ? 'lg:col-start-1 lg:col-end-6' : 'lg:col-start-8'
    }`}
  >
    <small
      class="font-ubuntu_mono text-base py-0 px-2 my-auto mb-4 rounded border-2 border-accent_dark"
    >
      {pretitle}
    </small>
    <h4 class="mb-4">{title}</h4>
    <Fragment set:html={body} />
  </div>
</div>
