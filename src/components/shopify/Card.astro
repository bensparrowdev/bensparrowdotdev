---
const { logo, timeEst, title, list, price } = Astro.props;
---

<div
  class={`price-card rounded-md py-7 px-5 flex flex-col bg-accent text-body dark:bg-primary_dark dark:text-accent_dark  w-full max-w-md md:w-[500px] mx-auto lg:w-auto ${
    title === 'Custom Build' && 'is-best-seller'
  }`}
>
  <div class="flex items-center justify-between h-16 mb-4">
    <Fragment set:html={logo} />
    <small
      class="font-ubuntu_mono text-base py-0 px-2 my-auto rounded border-2 border-primary dark:border-accent_dark"
    >
      avg. {timeEst ? timeEst : '1'}
      {timeEst !== '1' ? 'months' : 'month'}
    </small>
  </div>
  <div class="lg:flex-1 pb-5 mb-5 border-b dark:border-accent2_dark">
    <h4 class="mb-4">{title ? title : 'Title'}</h4>
    <ul>
      {list && list.map((text) => <li class="mb-2 text-base">{text}</li>)}
    </ul>
  </div>
  <div class="flex flex-col mb-2">
    {
      price ? (
        <>
          <span class="text-2xl">
            <small class="text-sm">from</small>
            <strong>£{price ? price : '0'}</strong> +VAT*
          </span>
          <small class="text-sm">VAT at standard (UK)</small>
        </>
      ) : (
        <strong class="text-2xl">Price on application</strong>
      )
    }
  </div>
  <div class="footer w-full">
    <a href="/contact" data-astro-prefetch>
      <button
        class="default-btn w-full dark:bg-secondary_dark dark:text-primary_dark"
        >Get Started
      </button>
    </a>
  </div>
</div>

<style>
  ul li {
    @apply flex items-center relative pl-6;
  }

  ul li::before {
    content: url(/checkmark.svg);
    @apply absolute top-1 left-0;
  }
</style>
