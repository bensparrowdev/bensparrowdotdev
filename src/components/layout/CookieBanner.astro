<div
  id="cookie-banner"
  class="fixed p-6 w-full sm:w-96 z-50 bottom-0 sm:bottom-5 left-0 sm:left-5 rounded bg-accent dark:bg-accent_dark shadow-xl hidden"
>
  <p class="text-base">
    We use cookies to enhance your browsing experience, and analyse site
    traffic. By clicking "Accept all", you consent to our use of Cookies
  </p>
  <div class="flex w-full gap-2">
    <button
      id="accept-cookies"
      class="default-btn my-0 w-1/2 text-base hover:bg-body hover:text-accent dark:hover:bg-body_dark dark:hover:text-accent_dark"
      >Accept all</button
    >
    <button
      id="reject-cookies"
      class="default-btn my-0 w-1/2 text-base hover:bg-body hover:text-accent dark:hover:bg-body_dark dark:hover:text-accent_dark"
      >Reject all</button
    >
  </div>
</div>
