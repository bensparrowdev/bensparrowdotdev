---
const { title, tags, featuredImage, readTime, slug } = Astro.props.fields;
const day = new Date(Astro.props.dateCreated).toLocaleDateString("en-gb", {
  day: "numeric",
});
const month = new Date(Astro.props.dateCreated).toLocaleDateString("en-gb", {
  month: "short",
});
const year = new Date(Astro.props.dateCreated).toLocaleDateString("en-gb", {
  year: "numeric",
});
---

<li class="grid grid-cols-10 sm:grid-cols-12 items-center mb-4">
  <p class="col-span-2 sm:col-span-2 text-sm m-0">
    {`${day} ${month}, ${year}`}
  </p>
  <div class="col-span-8 sm:col-span-7">
    <h5 class="m-0">
      <a
        class="text-primary hover:text-body dark:text-accent2_dark hover:dark:text-body_dark transition-[color] duration-150"
        href={`/blog/${slug}`}>{title}</a
      >
    </h5>
  </div>
  <ul class="col-span-3 hidden sm:block text-right">
    {
      tags.map((tag) => (
        <li class="font-ubuntu_mono text-sm border border-body dark:border-body_dark rounded py-1 px-2 mb-2 inline-block">
          {tag}
        </li>
      ))
    }
  </ul>
</li>
