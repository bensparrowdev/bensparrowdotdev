---
import MainHead from '../components/layout/MainHead.astro';
import Header from '../components/layout/Header.astro';
import CookieBanner from '../components/layout/CookieBanner.astro';

const {
  title = 'bensparrowdev Portfolio',
  description = "Hi, I'm Ben Sparrow and welcome to my portfolio website.",
  bgText = 'web developer',
} = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
  <MainHead {title} {description} />
  <body>
    <CookieBanner />
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-KMSX8SC"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->
    <main class="container px-4 pb-6">
      <Header />
      <slot />
      <h1
        class="font-eb_Garamond text-accent dark:text-bg_text_dark opacity-75 hidden sm:block text-[10vw] fixed break-normal whitespace-nowrap left-2 -bottom-4 m-0 p-0 -z-30"
      >
        {bgText}
      </h1>
      <span
        class="text-xs fixed bottom-0 right-2 px-1 bg-secondary dark:bg-secondary_dark dark:text-body_dark"
        >© {new Date().getFullYear()} ben sparrow - all rights reserved.</span
      >
    </main>
  </body>
</html>
