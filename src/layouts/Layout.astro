---
import MainHead from '../components/layout/MainHead.astro';
import Header from '../components/layout/Header.astro';
import CookieBanner from '../components/layout/CookieBanner.astro';

const {
  title = 'bensparrowdev Portfolio',
  description = "Hi, I'm Ben Sparrow and welcome to my portfolio website.",
  bgText = 'web developer',
  projects,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <MainHead {title} {description} {projects} />
  <body>
    <CookieBanner />
    <!-- Google Tag Manager (noscript) -->
    <noscript
      ><iframe
        src="https://www.googletagmanager.com/ns.html?id=GTM-KMSX8SC"
        height="0"
        width="0"
        style="display:none;visibility:hidden"></iframe></noscript
    >
    <!-- End Google Tag Manager (noscript) -->
    <main class="container px-4 pb-6">
      <Header />
      <slot />
      <h1
        class="font-eb_Garamond text-accent dark:text-bg_text_dark opacity-75 hidden sm:block text-[10vw] fixed break-normal whitespace-nowrap left-2 -bottom-4 m-0 p-0 -z-30"
      >
        {bgText}
      </h1>
      <span
        class="text-xs fixed bottom-0 right-2 px-1 bg-secondary dark:bg-secondary_dark dark:text-body_dark"
        >© {new Date().getFullYear()} ben sparrow - all rights reserved.</span
      >
    </main>
  </body>
</html>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const observer = new IntersectionObserver((entries, observer) => {
      entries.forEach((entry) => {
        if (entry.isIntersecting) {
          entry.target.classList.add('animated');
          observer.unobserve(entry.target);
        }
      });
    });

    document.querySelectorAll('.animate--slide-up').forEach((element) => {
      observer.observe(element);
    });
  });

  // Ackee Analytics Tracking
  import * as ackeeTracker from 'ackee-tracker';
  ackeeTracker
    .create('https://ackee-analytics.netlify.app')
    .record('9347f1cd-8fe9-4c02-8f6a-cabb23d980f2');
</script>
