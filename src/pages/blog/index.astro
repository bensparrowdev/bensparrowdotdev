---
import { client, type BlogPostSkeleton } from '../../lib/contentful';
import Layout from '../../layouts/Layout.astro';
import ArticleListItem from '../../components/blog/ArticleListItem.astro';

const { items } = await client.getEntries<BlogPostSkeleton>({
  content_type: 'blogPost',
});

// Sort blog posts by descending date
const posts = items.sort(
  (a, b) =>
    new Date(a.sys.updatedAt).valueOf() - new Date(b.sys.updatedAt).valueOf()
);
---

<Layout
  title="Blog | bensparrowdev"
  description="Welcome to my blog. Here you'll find articles around web development, how technology can solve business problems, and my journey as a freelance developer."
  bgText="ponderer"
>
  <section class="container-lg mx-auto mb-32">
    <h1>Blog.</h1>
    <div class="container mb-16">
      <p>
        On this page, discover my irregular and occasional blog posts on web
        development, technology, freelancing and other trivial things.
      </p>
    </div>
    <div class="container-md">
      <ul>
        {
          posts.map((post) => (
            <ArticleListItem
              fields={post.fields}
              dateCreated={post.sys.updatedAt}
            />
          ))
        }
      </ul>
    </div>
  </section>
</Layout>
